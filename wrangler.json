{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifepath-repo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "life-path.icu", "custom_domain": true },
    { "pattern": "www.life-path.icu", "custom_domain": true }
  ]
}
